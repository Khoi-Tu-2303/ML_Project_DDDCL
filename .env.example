# Copy to .env locally. Never commit real credentials.
# Public non-gated datasets can normally be downloaded without HF_TOKEN.
HF_TOKEN=
HF_DATASET_REPO=YOUR_HF_USERNAME/dynamic-ddcl-benchmarks
# Fill ONLY after upload: full dataset commit SHA, not main/latest.
HF_DATASET_REVISION=
WANDB_ENTITY=
WANDB_PROJECT=dynamic-ddcl
WANDB_API_KEY=
WANDB_MODE=offline
